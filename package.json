{
  "name": "pi-kit",
  "private": true,
  "version": "0.1.0",
  "description": "Personal Pi extensions, skills, and subagents.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/*.ts",
      "./extensions/*/index.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "./node_modules/@juicesharp/rpiv-btw/index.ts",
      "./node_modules/@juicesharp/rpiv-todo/index.ts",
      "./node_modules/pi-mcp-adapter/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@juicesharp/rpiv-ask-user-question": "^1.13.0",
    "@juicesharp/rpiv-btw": "^1.13.0",
    "@juicesharp/rpiv-todo": "^1.13.0",
    "pi-mcp-adapter": "^2.10.0"
  }
}
